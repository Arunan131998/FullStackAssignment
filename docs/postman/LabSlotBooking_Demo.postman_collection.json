{
  "info": {
    "name": "Lab Slot Booking Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demo flow for Lab Slot Booking assignment"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "Admin@123" },
    { "key": "studentEmail", "value": "student@example.com" },
    { "key": "studentPassword", "value": "Student@123" },
    { "key": "adminToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "labId", "value": "" },
    { "key": "slotId", "value": "" },
    { "key": "bookingId", "value": "" }
  ],
  "item": [
    {
      "name": "Health - Gateway",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Login - Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Store admin token', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('token');",
              "  pm.collectionVariables.set('adminToken', body.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login - Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Store student token', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('token');",
              "  pm.collectionVariables.set('studentToken', body.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Create Lab - Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Store lab id', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('data');",
              "  pm.collectionVariables.set('labId', body.data._id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Computer Networks Lab\",\n  \"location\": \"Block A - Floor 2\",\n  \"totalSeats\": 30,\n  \"equipmentTags\": [\"routers\", \"switches\"]\n}"
        },
        "url": "{{baseUrl}}/booking/labs"
      }
    },
    {
      "name": "Create Slot - Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Store slot id', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('data');",
              "  pm.collectionVariables.set('slotId', body.data._id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"labId\": \"{{labId}}\",\n  \"date\": \"2026-05-01\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"11:00\",\n  \"capacity\": 5\n}"
        },
        "url": "{{baseUrl}}/booking/slots"
      }
    },
    {
      "name": "List Slots - Student",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ],
        "url": "{{baseUrl}}/booking/slots"
      }
    },
    {
      "name": "Create Booking - Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Store booking id', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('data');",
              "  pm.collectionVariables.set('bookingId', body.data._id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"slotId\": \"{{slotId}}\",\n  \"purpose\": \"Assignment preparation\"\n}"
        },
        "url": "{{baseUrl}}/booking/bookings"
      }
    },
    {
      "name": "List Pending Bookings - Admin",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/booking/bookings?status=PENDING"
      }
    },
    {
      "name": "Approve Booking - Admin",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/booking/bookings/{{bookingId}}/approve"
      }
    },
    {
      "name": "My Bookings - Student",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ],
        "url": "{{baseUrl}}/booking/bookings/me"
      }
    }
  ]
}
